{
  "DatabaseProvider": "Sqlite",

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=esport-team-manager.db"
  },

  "PrivateImageStorage": {
    "RootPath": "App_Data/private-images",
    "MaximumUploadSizeBytes": 10485760,
    "MinimumDimensionPixels": 64,
    "MaximumDimensionPixels": 8192,
    "MaximumPixelCount": 40000000,
    "TeamLogoMaximumEdgePixels": 1024,
    "StrategyImageMaximumEdgePixels": 2560,
    "ThumbnailMaximumEdgePixels": 480,
    "WebpQuality": 82
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}