@using EsportTeamManager.Web.Models.Navigation
@model TeamNavigationViewModel

@{
    string? currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool teamsNavigationIsActive = string.Equals(currentController, "Teams", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

@if (Model.Teams.Count == 0)
{
    <ul class="navbar-nav me-auto">
        <li class="nav-item">
            <a class="nav-link app-main-navigation-link @(teamsNavigationIsActive ? "app-main-navigation-link-active" : string.Empty)"
               asp-controller="Teams"
               asp-action="Index"
               aria-current="@(teamsNavigationIsActive ? "page" : null)">
                Mes équipes
            </a>
        </li>
    </ul>
}
else
{
    string activeTeamLabel = Model.ActiveTeam is null
        ? "Choisir une équipe"
        : string.IsNullOrWhiteSpace(Model.ActiveTeam.Tag)
            ? Model.ActiveTeam.Name
            : $"{Model.ActiveTeam.Name} · {Model.ActiveTeam.Tag}";

    <div class="app-team-navigation me-auto">
        <div class="dropdown app-team-selector">
            <button class="btn btn-outline-secondary dropdown-toggle app-team-selector-button"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Changer d’équipe. Sélection actuelle : @activeTeamLabel">
                @activeTeamLabel
            </button>

            <ul class="dropdown-menu app-team-selector-menu">
                @foreach (TeamNavigationItemViewModel team in Model.Teams)
                {
                    string teamLabel = string.IsNullOrWhiteSpace(team.Tag) ? team.Name : $"{team.Name} · {team.Tag}";
                    bool teamIsActive = Model.ActiveTeam is not null && team.TeamId == Model.ActiveTeam.TeamId;
                    bool teamIsCurrentPage = teamIsActive && !teamsNavigationIsActive;

                    <li>
                        <a class="dropdown-item @(teamIsActive ? "active" : string.Empty)"
                           asp-controller="Activities"
                           asp-action="Index"
                           asp-route-teamId="@team.TeamId"
                           aria-current="@(teamIsCurrentPage ? "true" : null)">
                            @teamLabel
                        </a>
                    </li>
                }

                <li><hr class="dropdown-divider" /></li>

                <li>
                    <a class="dropdown-item @(teamsNavigationIsActive ? "active" : string.Empty)"
                       asp-controller="Teams"
                       asp-action="Index"
                       aria-current="@(teamsNavigationIsActive ? "page" : null)">
                        Mes équipes
                    </a>
                </li>
            </ul>
        </div>

        <ul class="navbar-nav app-team-navigation-links">
            @if (Model.ActiveTeam is null)
            {
                <li class="nav-item">
                    <a class="nav-link app-main-navigation-link @(teamsNavigationIsActive ? "app-main-navigation-link-active" : string.Empty)"
                       asp-controller="Teams"
                       asp-action="Index"
                       aria-current="@(teamsNavigationIsActive ? "page" : null)">
                        Mes équipes
                    </a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link app-main-navigation-link @(Model.CalendarIsActive ? "app-main-navigation-link-active" : string.Empty)"
                       asp-controller="Activities"
                       asp-action="Index"
                       asp-route-teamId="@Model.ActiveTeam.TeamId"
                       aria-current="@(Model.CalendarIsActive ? "page" : null)">
                        Calendrier
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link app-main-navigation-link @(Model.ManagementIsActive ? "app-main-navigation-link-active" : string.Empty)"
                       asp-controller="Teams"
                       asp-action="Management"
                       asp-route-teamId="@Model.ActiveTeam.TeamId"
                       aria-current="@(Model.ManagementIsActive ? "page" : null)">
                        Gestion d’équipe
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link app-main-navigation-link @(Model.StrategiesIsActive ? "app-main-navigation-link-active" : string.Empty)"
                       asp-controller="Strategies"
                       asp-action="Index"
                       asp-route-teamId="@Model.ActiveTeam.TeamId"
                       aria-current="@(Model.StrategiesIsActive ? "page" : null)">
                        Stratégies
                    </a>
                </li>
            }
        </ul>
    </div>
}