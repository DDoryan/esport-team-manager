<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <title>@ViewData["Title"] - Esport Team Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EsportTeamManager.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>

    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Navigation principale">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Teams" asp-action="Entry">
                    <span class="brand-mark" aria-hidden="true">ETM</span>
                    <span>Esport Team Manager</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Afficher ou masquer la navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Teams" asp-action="Index">Mes équipes</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Teams" asp-action="Entry">Calendrier</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="navbar-text">@User.Identity.Name</span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Se déconnecter</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Se connecter</a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Créer un compte</a>
                            </li>
                        }
                    </ul>

                    <span class="app-version ms-lg-3">MVP</span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-shell">
        <main id="main-content" class="app-main" role="main" tabindex="-1">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="status">@successMessage</div>
            }

            @if (TempData["WarningMessage"] is string warningMessage)
            {
                <div class="alert alert-warning" role="alert">@warningMessage</div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container app-footer-content">
            <span>&copy; 2026 Esport Team Manager</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>