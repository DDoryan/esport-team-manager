@model ErrorViewModel

@{
    ViewData["Title"] = "Erreur";
}

<section class="py-4" aria-labelledby="error-title">
    <div class="alert alert-danger" role="alert">
        <h1 id="error-title" class="h3">Une erreur est survenue</h1>

        <p class="mb-0">
            La demande n’a pas pu être traitée. Veuillez réessayer ultérieurement.
        </p>

        @if (Model.ShowCorrelationId)
        {
            <hr />

            <p class="mb-0">
                <strong>Identifiant de suivi :</strong>
                <code>@Model.CorrelationId</code>
            </p>
        }
    </div>

    <a class="btn btn-outline-light" asp-controller="Home" asp-action="Index">
        Retour à l’accueil
    </a>
</section>