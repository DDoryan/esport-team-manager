@using EsportTeamManager.Web.Models.Teams

@model TeamManagementViewModel

@{
    ViewData["Title"] = Model.Name;
    string memberCountLabel = Model.Members.Count == 1 ? "1 membre actif" : $"{Model.Members.Count} membres actifs";
}

<section class="team-management-page" aria-labelledby="team-management-title">
    <header class="mb-4">
        <h1 id="team-management-title" class="mb-0">@Model.Name</h1>
    </header>

    <section class="card team-members-panel" aria-labelledby="team-members-title">
        <div class="card-body">
            <header class="team-members-header mb-3">
                <div>
                    <h2 id="team-members-title" class="h3 mb-1">Membres</h2>
                    <p class="text-body-secondary mb-0">@memberCountLabel</p>
                </div>

                @if (Model.CurrentUserCanInviteMembers)
                {
                    <a class="btn btn-primary team-members-invite-button"
                       asp-controller="Teams"
                       asp-action="Invite"
                       asp-route-teamId="@Model.TeamId">
                        <span aria-hidden="true">+</span>
                        Inviter un membre
                    </a>
                }
            </header>

            <div class="team-members-desktop">
                <div class="table-responsive">
                    <table class="table team-members-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Identité</th>
                                <th scope="col">Rôle</th>
                                <th scope="col">Entrée</th>
                                <th scope="col">Statut</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (TeamMemberViewModel member in Model.Members)
                            {
                                <tr>
                                    <td>
                                        <span class="team-member-identity">
                                            <strong>@member.Pseudo</strong>
                                            <span class="text-body-secondary">#@member.Tag</span>
                                        </span>
                                    </td>
                                    <td>@member.RoleLabel</td>
                                    <td>
                                        <time datetime="@member.JoinedAtUtc.ToString("O")">
                                            @member.JoinedAtUtc.ToString("dd/MM/yyyy")
                                        </time>
                                    </td>
                                    <td>
                                        @if (member.IsOwner)
                                        {
                                            <span class="badge team-owner-badge">Propriétaire</span>
                                        }
                                        else
                                        {
                                            <span class="badge team-member-badge">Membre</span>
                                        }
                                    </td>
                                    <td>
                                        @if (member.CanChangeRole || member.CanRemove)
                                        {
                                            <div class="team-member-actions">
                                                @if (member.CanChangeRole)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary"
                                                       asp-controller="Teams"
                                                       asp-action="ChangeRole"
                                                       asp-route-teamId="@Model.TeamId"
                                                       asp-route-teamMembershipId="@member.TeamMembershipId">
                                                        Modifier
                                                    </a>
                                                }

                                                @if (member.CanRemove)
                                                {
                                                    <a class="btn btn-sm btn-outline-danger"
                                                       asp-controller="Teams"
                                                       asp-action="RemoveMember"
                                                       asp-route-teamId="@Model.TeamId"
                                                       asp-route-teamMembershipId="@member.TeamMembershipId">
                                                        Exclure
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="team-members-mobile">
                @foreach (TeamMemberViewModel member in Model.Members)
                {
                    <article class="team-member-card">
                        <div class="team-member-card-header">
                            <span class="team-member-identity">
                                <strong>@member.Pseudo</strong>
                                <span class="text-body-secondary">#@member.Tag</span>
                            </span>

                            @if (member.CanChangeRole || member.CanRemove)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary team-member-actions-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Actions pour @member.Pseudo#@member.Tag">
                                        <span aria-hidden="true">⋮</span>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @if (member.CanChangeRole)
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-controller="Teams"
                                                   asp-action="ChangeRole"
                                                   asp-route-teamId="@Model.TeamId"
                                                   asp-route-teamMembershipId="@member.TeamMembershipId">
                                                    Modifier le rôle
                                                </a>
                                            </li>
                                        }

                                        @if (member.CanRemove)
                                        {
                                            <li>
                                                <a class="dropdown-item text-danger"
                                                   asp-controller="Teams"
                                                   asp-action="RemoveMember"
                                                   asp-route-teamId="@Model.TeamId"
                                                   asp-route-teamMembershipId="@member.TeamMembershipId">
                                                    Exclure
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>

                        <div class="team-member-role-row">
                            <p class="team-member-role mb-0">@member.RoleLabel</p>

                            @if (member.IsOwner)
                            {
                                <span class="badge team-owner-badge">Propriétaire</span>
                            }
                            else
                            {
                                <span class="badge team-member-badge">Membre</span>
                            }
                        </div>

                        <p class="text-body-secondary mb-0">
                            Entrée :
                            <time datetime="@member.JoinedAtUtc.ToString("O")">
                                @member.JoinedAtUtc.ToString("dd/MM/yyyy")
                            </time>
                        </p>
                    </article>
                }
            </div>
        </div>
    </section>

    @if (Model.CurrentUserIsOwner)
    {
        <section class="card mt-4" aria-labelledby="ownership-transfer-title">
            <div class="card-body d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                @if (Model.PendingOwnershipTransfer is not null)
                {
                    <div>
                        <h2 id="ownership-transfer-title" class="h3 mb-1">Transfert de propriété en attente</h2>
                        <p class="text-body-secondary mb-0">
                            Proposition envoyée à
                            <strong>@Model.PendingOwnershipTransfer.RecipientPseudo#@Model.PendingOwnershipTransfer.RecipientTag</strong>.
                            La propriété changera uniquement après son acceptation.
                        </p>
                    </div>

                    <form asp-controller="Teams" asp-action="CancelOwnershipTransfer" method="post" class="mb-0">
                        <input type="hidden" name="teamId" value="@Model.TeamId" />
                        <input type="hidden" name="ownershipTransferId" value="@Model.PendingOwnershipTransfer.OwnershipTransferId" />

                        <button type="submit" class="btn btn-outline-danger">
                            Annuler le transfert
                        </button>
                    </form>
                }
                else
                {
                    <div>
                        <h2 id="ownership-transfer-title" class="h3 mb-1">Transfert de propriété</h2>

                        @if (Model.Members.Any(member => !member.IsOwner))
                        {
                            <p class="text-body-secondary mb-0">
                                Proposez la propriété de l’équipe à un membre actif.
                            </p>
                        }
                        else
                        {
                            <p class="text-body-secondary mb-0">
                                Ajoutez au moins un autre membre avant de pouvoir transférer la propriété.
                            </p>
                        }
                    </div>

                    @if (Model.Members.Any(member => !member.IsOwner))
                    {
                        <a class="btn btn-outline-primary"
                           asp-controller="Teams"
                           asp-action="TransferOwnership"
                           asp-route-teamId="@Model.TeamId">
                            Transférer la propriété
                        </a>
                    }
                }
            </div>
        </section>
    }

    @if (Model.CurrentUserCanLeaveTeam)
    {
        <section class="card team-departure-panel mt-4" aria-labelledby="team-departure-title">
            <div class="card-body team-departure-content">
                <div>
                    <h2 id="team-departure-title" class="h3 mb-1">Départ de l’équipe</h2>
                    <p class="text-body-secondary mb-0">
                        Quitter l’équipe entraîne la perte immédiate de son accès.
                    </p>
                </div>

                <a class="btn btn-outline-danger team-departure-button"
                   asp-controller="Teams"
                   asp-action="LeaveTeam"
                   asp-route-teamId="@Model.TeamId">
                    Quitter l’équipe
                </a>
            </div>
        </section>
    }
</section>