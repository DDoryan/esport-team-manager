@using EsportTeamManager.Web.Models.Teams

@model LeaveTeamViewModel

@{
    ViewData["Title"] = $"Quitter l’équipe — {Model.TeamName}";
}

<section class="team-invite-page" aria-labelledby="leave-team-title">
    <header class="team-invite-header mb-4">
        <a class="team-invite-back-link"
           asp-controller="Teams"
           asp-action="Management"
           asp-route-teamId="@Model.TeamId">
            <span aria-hidden="true">←</span>
            Retour à @Model.TeamName
        </a>

        <h1 id="leave-team-title" class="mb-2">Quitter l’équipe</h1>
        <p class="text-body-secondary mb-0">
            Confirmez votre départ de l’équipe.
        </p>
    </header>

    <section class="card team-invite-panel" aria-labelledby="leave-team-confirmation-title">
        <div class="card-body">
            <h2 id="leave-team-confirmation-title" class="h3 mb-4">@Model.TeamName</h2>

            <div class="alert alert-warning" role="alert">
                Vous perdrez immédiatement tout accès à cette équipe et à son historique. Votre période d’appartenance restera conservée pour les membres actifs.
            </div>

            <form asp-controller="Teams" asp-action="LeaveTeam" method="post">
                <input asp-for="TeamId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="team-invite-actions">
                    <button type="submit" class="btn btn-danger">Confirmer mon départ</button>

                    <a class="btn btn-outline-secondary"
                       asp-controller="Teams"
                       asp-action="Management"
                       asp-route-teamId="@Model.TeamId">
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </section>
</section>