@model EsportTeamManager.Web.Models.Teams.CreateTeamViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autocomplete="organization" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-12 col-sm-5 col-lg-3">
        <label asp-for="Tag" class="form-label"></label>
        <input asp-for="Tag" class="form-control" placeholder="Facultatif" autocomplete="off" />
        <div class="form-text">Entre 2 et 6 caractères.</div>
        <span asp-validation-for="Tag" class="text-danger"></span>
    </div>

    <div class="col-12 col-sm-7 col-lg-3">
        <label asp-for="TimeZoneId" class="form-label"></label>
        <input asp-for="TimeZoneId" class="form-control" autocomplete="off" />
        <div class="form-text">Identifiant IANA, par exemple Europe/Paris.</div>
        <span asp-validation-for="TimeZoneId" class="text-danger"></span>
    </div>
</div>

<div class="d-flex justify-content-end mt-4">
    <button type="submit" class="btn btn-primary">Créer l’équipe</button>
</div>