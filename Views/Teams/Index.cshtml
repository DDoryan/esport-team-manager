@model EsportTeamManager.Web.Models.Teams.TeamsIndexViewModel

@{
    ViewData["Title"] = "Mes équipes";
}

<section aria-labelledby="teams-title">
    <div class="mb-4">
        <h1 id="teams-title" class="mb-2">Mes équipes</h1>
        <p class="text-body-secondary mb-0">
            Choisissez l’équipe dont vous souhaitez ouvrir le calendrier.
        </p>
    </div>

    @if (Model.Teams.Count == 0)
    {
        <div class="alert alert-secondary mb-4" role="status">
            Vous n’appartenez encore à aucune équipe. Créez votre première équipe ci-dessous.
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var team in Model.Teams)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <a class="team-card-link" asp-controller="Activities" asp-action="Index" asp-route-teamId="@team.TeamId" aria-label="Ouvrir le calendrier de l’équipe @team.Name">
                        <article class="card team-card h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="team-card-header">
                                    <span class="team-card-mark" aria-hidden="true">@team.Initials</span>

                                    <div>
                                        <h2 class="h5 mb-1">@team.Name</h2>
                                        <p class="text-body-secondary mb-0">@(team.Tag ?? "Sans tag")</p>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    <span class="badge text-bg-secondary">@team.RoleLabel</span>

                                    @if (team.IsOwner)
                                    {
                                        <span class="badge team-owner-badge">Propriétaire</span>
                                    }
                                </div>

                                <span class="team-card-calendar mt-auto pt-4">
                                    Calendrier <span aria-hidden="true">→</span>
                                </span>
                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>
    }

    <section id="create-team" class="card team-create-panel" aria-labelledby="create-team-title">
        <div class="card-body p-4">
            <h2 id="create-team-title" class="h3 mb-4">Créer une équipe</h2>

            <form asp-controller="Teams" asp-action="Create" method="post">
                <partial name="_CreateTeamForm" model="Model.CreateTeam" />
            </form>
        </div>
    </section>

    <div class="container team-create-shortcut-container">
        <a class="btn btn-primary team-create-shortcut" href="#create-team" hidden>Créer une équipe</a>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}