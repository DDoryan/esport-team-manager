@using EsportTeamManager.Web.Models.Teams

@model RemoveTeamMemberViewModel

@{
    ViewData["Title"] = $"Exclure un membre — {Model.TeamName}";
}

<section class="team-invite-page" aria-labelledby="remove-member-title">
    <header class="team-invite-header mb-4">
        <a class="team-invite-back-link"
           asp-controller="Teams"
           asp-action="Management"
           asp-route-teamId="@Model.TeamId">
            <span aria-hidden="true">←</span>
            Retour à @Model.TeamName
        </a>

        <h1 id="remove-member-title" class="mb-2">Exclure un membre</h1>
        <p class="text-body-secondary mb-0">
            Vérifiez l’identité du membre avant de confirmer l’exclusion.
        </p>
    </header>

    <section class="card team-invite-panel" aria-labelledby="remove-member-confirmation-title">
        <div class="card-body">
            <h2 id="remove-member-confirmation-title" class="h3 mb-4">@Model.MemberIdentity</h2>

            <div class="alert alert-warning" role="alert">
                Ce membre perdra immédiatement tout accès à l’équipe. Son historique d’appartenance restera conservé.
            </div>

            <form asp-controller="Teams" asp-action="RemoveMember" method="post">
                <input asp-for="TeamId" type="hidden" />
                <input asp-for="TeamMembershipId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="team-invite-actions">
                    <button type="submit" class="btn btn-danger">Confirmer l’exclusion</button>

                    <a class="btn btn-outline-secondary"
                       asp-controller="Teams"
                       asp-action="Management"
                       asp-route-teamId="@Model.TeamId">
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </section>
</section>