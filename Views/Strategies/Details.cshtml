@using EsportTeamManager.Domain.Enums
@using RepriseWeb.ViewModels.Strategies

@model StrategyDetailsViewModel

@{
    ViewData["Title"] = Model.CurrentName;
}

<section class="strategy-details-page"
         aria-labelledby="strategy-details-title">

    <header class="strategy-editor-header">
        <a class="strategy-editor-back-link"
           asp-controller="Strategies"
           asp-action="Index"
           asp-route-teamId="@Model.TeamId">
            <span aria-hidden="true">←</span>
            Retour aux stratégies
        </a>

        <h1 id="strategy-details-title" class="visually-hidden">
            @Model.CurrentName
        </h1>
    </header>

    <div class="strategy-details-layout @(Model.CanManage ? null : "strategy-details-layout-readonly")">

        <article class="strategy-details-panel"
                 aria-labelledby="strategy-current-title">

            <div class="strategy-details-heading">
                <div>
                    <h2 id="strategy-current-title"
                        class="h3 mb-2">
                        @Model.CurrentName
                    </h2>

                    <p class="strategy-card-metadata mb-0">
                        @Model.MapName · @Model.SideLabel
                    </p>
                </div>

                <span class="strategy-status-badge @(Model.IsActive ? "strategy-status-active" : "strategy-status-inactive")">
                    @Model.StatusLabel
                </span>
            </div>

            <div class="strategy-details-image"
                 aria-label="Illustration de la stratégie"
                 data-strategy-image-preview>

                @if (Model.HasImage)
                {
                    string imageUrl = Url.Action("Image", "Strategies", new
                    {
                        teamId = Model.TeamId,
                        strategyId = Model.StrategyId
                    })!;

                    <div class="strategy-image-preview-placeholder"
                         hidden
                         data-strategy-image-preview-placeholder>
                        <i class="bi bi-image"
                           aria-hidden="true"></i>

                        <span>Aucune image</span>
                    </div>

                    <button class="strategy-image-preview-link"
                            type="button"
                            aria-label="Ouvrir l’image de la stratégie en grand"
                            data-strategy-image-preview-link>
                        <img src="@imageUrl"
                             alt="Illustration de la stratégie @Model.CurrentName"
                             data-strategy-image-preview-content />
                    </button>

                    <a class="strategy-image-download-button"
                       asp-controller="Strategies"
                       asp-action="DownloadImage"
                       asp-route-teamId="@Model.TeamId"
                       asp-route-strategyId="@Model.StrategyId"
                       download
                       aria-label="Télécharger l’image de la stratégie"
                       title="Télécharger l’image">
                        <a class="strategy-image-download-button"
                           asp-controller="Strategies"
                           asp-action="DownloadImage"
                           asp-route-teamId="@Model.TeamId"
                           asp-route-strategyId="@Model.StrategyId"
                           download
                           aria-label="Télécharger l’image de la stratégie"
                           title="Télécharger l’image">
                            <span aria-hidden="true">💾</span>
                        </a>
                    </a>
                }
                else
                {
                    <div class="strategy-image-preview-placeholder"
                         data-strategy-image-preview-placeholder>
                        <i class="bi bi-image"
                           aria-hidden="true"></i>

                        <span>Aucune image</span>
                    </div>

                    <button class="strategy-image-preview-link"
                            type="button"
                            aria-label="Ouvrir la nouvelle image en grand"
                            hidden
                            data-strategy-image-preview-link>
                        <img src=""
                             alt="Aperçu de la nouvelle image"
                             hidden
                             data-strategy-image-preview-content />
                    </button>
                }
            </div>

            <dialog class="strategy-image-dialog"
                    aria-label="Aperçu agrandi de l’image"
                    data-strategy-image-dialog>
                <div class="strategy-image-dialog-content">
                    <button class="strategy-image-dialog-close"
                            type="button"
                            aria-label="Fermer l’aperçu"
                            data-strategy-image-dialog-close>
                        ×
                    </button>

                    <img src=""
                         alt="Image agrandie"
                         data-strategy-image-dialog-content />
                </div>
            </dialog>

            <section class="strategy-details-section"
                     aria-labelledby="strategy-description-title">

                <h3 id="strategy-description-title"
                    class="h5">
                    Description
                </h3>

                @if (string.IsNullOrWhiteSpace(Model.CurrentDescription))
                {
                    <p class="text-body-secondary mb-0">
                        Aucune description.
                    </p>
                }
                else
                {
                    <p class="strategy-details-description mb-0">@Model.CurrentDescription</p>
                }
            </section>

            <section class="strategy-details-section"
                     aria-labelledby="strategy-link-title">

                <h3 id="strategy-link-title"
                    class="h5">
                    URL externe
                </h3>

                @if (string.IsNullOrWhiteSpace(Model.CurrentExternalUrl))
                {
                    <p class="text-body-secondary mb-0">
                        Aucune URL externe.
                    </p>
                }
                else
                {
                    <a href="@Model.CurrentExternalUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        @Model.CurrentExternalUrl
                    </a>
                }
            </section>
        </article>

        @if (Model.CanManage)
        {
            <section class="strategy-editor-panel"
                     aria-labelledby="strategy-update-title">

                <h2 id="strategy-update-title"
                    class="h3 mb-3">
                    Modifier la stratégie
                </h2>

                <form method="post"
                      asp-controller="Strategies"
                      asp-action="Details"
                      asp-route-teamId="@Model.TeamId"
                      asp-route-strategyId="@Model.StrategyId"
                      enctype="multipart/form-data">

                    <input asp-for="TeamId" type="hidden" />
                    <input asp-for="StrategyId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"
                         role="alert"></div>

                    <div class="strategy-create-left">

                        <div class="strategy-editor-field">
                            <label asp-for="Name">Nom</label>

                            <input asp-for="Name"
                                   class="form-control"
                                   maxlength="100"
                                   autocomplete="off" />

                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="strategy-editor-field">
                            <label asp-for="MapId">Carte</label>

                            <select asp-for="MapId"
                                    class="form-select">

                                @foreach (StrategyMapOptionViewModel map in Model.Maps)
                                {
                                    <option value="@map.MapId">
                                        @map.Name
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="MapId"
                                  class="text-danger"></span>
                        </div>

                        <div class="strategy-create-choice-row">

                            <fieldset class="strategy-editor-choice-group">
                                <legend>Camp</legend>

                                <div class="strategy-editor-choice-options">
                                    <label class="team-calendar-filter calendar-filter-vod-review">
                                        <input asp-for="Side"
                                               class="form-check-input"
                                               type="radio"
                                               value="@StrategySide.Attack" />

                                        <span class="team-calendar-filter-icon strategy-filter-sword-icon"
                                              aria-hidden="true">⚔</span>

                                        <span>Attaque</span>
                                    </label>

                                    <label class="team-calendar-filter strategy-filter-defense">
                                        <input asp-for="Side"
                                               class="form-check-input"
                                               type="radio"
                                               value="@StrategySide.Defense" />

                                        <svg class="team-calendar-filter-icon strategy-filter-svg-icon"
                                             viewBox="0 0 16 16"
                                             aria-hidden="true"
                                             focusable="false">
                                            <path fill="currentColor"
                                                  d="M8 0 14 2.25v4.1c0 4.15-2.55 7.55-6 9.65-3.45-2.1-6-5.5-6-9.65v-4.1L8 0Zm0 2.05L4 3.55v2.8c0 3.05 1.7 5.7 4 7.45 2.3-1.75 4-4.4 4-7.45v-2.8L8 2.05Z" />
                                        </svg>

                                        <span>Défense</span>
                                    </label>
                                </div>

                                <span asp-validation-for="Side"
                                      class="text-danger"></span>
                            </fieldset>

                            <fieldset class="strategy-editor-choice-group">
                                <legend>État</legend>

                                <div class="strategy-editor-choice-options">
                                    <label class="team-calendar-filter calendar-filter-completed">
                                        <input asp-for="IsActive"
                                               class="form-check-input"
                                               type="radio"
                                               value="true" />

                                        <svg class="team-calendar-filter-icon strategy-filter-svg-icon"
                                             viewBox="0 0 16 16"
                                             aria-hidden="true"
                                             focusable="false">
                                            <path fill="none"
                                                  stroke="currentColor"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M2.5 8.5 6.25 12 13.5 4" />
                                        </svg>

                                        <span>Active</span>
                                    </label>

                                    <label class="team-calendar-filter calendar-filter-cancelled">
                                        <input asp-for="IsActive"
                                               class="form-check-input"
                                               type="radio"
                                               value="false" />

                                        <svg class="team-calendar-filter-icon strategy-filter-svg-icon"
                                             viewBox="0 0 16 16"
                                             aria-hidden="true"
                                             focusable="false">
                                            <path fill="none"
                                                  stroke="currentColor"
                                                  stroke-linecap="round"
                                                  stroke-width="2"
                                                  d="M3 3 13 13M13 3 3 13" />
                                        </svg>

                                        <span>Inactive</span>
                                    </label>
                                </div>
                            </fieldset>

                        </div>

                        <div class="strategy-editor-field">
                            <label asp-for="ExternalUrl">
                                URL externe
                            </label>

                            <input asp-for="ExternalUrl"
                                   class="form-control"
                                   type="url"
                                   maxlength="2048"
                                   placeholder="https://..." />

                            <span asp-validation-for="ExternalUrl"
                                  class="text-danger"></span>
                        </div>

                        <div class="strategy-editor-field">
                            <label asp-for="Image">
                                @(Model.HasImage ? "Remplacer l’image" : "Ajouter une image")
                            </label>

                            <input asp-for="Image"
                                   class="form-control"
                                   type="file"
                                   accept="image/png,image/jpeg,image/webp"
                                   data-strategy-image-input />

                            <div class="form-text">
                                PNG, JPEG ou WebP. Laissez ce champ vide pour conserver l’image actuelle.
                            </div>

                            <span asp-validation-for="Image"
                                  class="text-danger"></span>
                        </div>

                        <div class="strategy-editor-field strategy-create-description">
                            <label asp-for="Description">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      maxlength="5000"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="strategy-details-editor-footer">
                        <p class="strategy-editor-content-help">
                            Conservez au moins une description, une URL externe ou une image.
                        </p>

                        <div class="strategy-editor-actions">
                            <button class="btn btn-primary"
                                    type="submit">
                                Enregistrer les modifications
                            </button>
                        </div>
                    </div>
                </form>
            </section>
        }
    </div>
</section>

@section Scripts
{
    @if (Model.CanManage)
    {
        <partial name="_ValidationScriptsPartial" />

        <script src="~/js/strategy-image-preview.js"
                asp-append-version="true"
                defer></script>
    }
}