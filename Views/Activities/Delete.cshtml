@model RepriseWeb.Models.TeamActivity

@{
    ViewData["Title"] = "Supprimer une activité";
}

<h1>Supprimer une activité</h1>

<div class="alert alert-danger">
    Confirmez-vous la suppression de cette activité ?
</div>

<dl class="row">
    <dt class="col-sm-3">Titre</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.Type</dd>

    <dt class="col-sm-3">Date et heure</dt>
    <dd class="col-sm-9">
        @Model.StartDate.ToString("dd/MM/yyyy HH:mm")
    </dd>
</dl>

<form asp-controller="Activities"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Confirmer la suppression
    </button>

    <a asp-controller="Activities"
       asp-action="Index"
       class="btn btn-secondary">
        Annuler
    </a>
</form>