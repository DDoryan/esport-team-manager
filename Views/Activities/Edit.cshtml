@using EsportTeamManager.Domain.Enums

@model RepriseWeb.ViewModels.Activities.EditActivityViewModel

@{
    string activityTitle = string.IsNullOrWhiteSpace(Model.Subtitle) ? Model.TypeLabel : $"{Model.TypeLabel} — {Model.Subtitle}";
    ViewData["Title"] = activityTitle;
    ViewData["HtmlClass"] = "activity-edit-fixed-page app-local-scroll-page";
    bool matchSectionIsVisible = Model.TypeCode is "Pracc" or "OfficialMatch";

    string resultLabel = Model.Result switch
    {
        MatchResult.Victory => "Victoire",
        MatchResult.Defeat => "Défaite",
        MatchResult.Draw => "Égalité",
        _ => "Non disponible"
    };
}

<section class="activity-edit-page app-scroll-region" aria-labelledby="activity-edit-title">
    <header class="activity-edit-header">
        <div>
            <h1 id="activity-edit-title" class="mb-2">@activityTitle</h1>
            <p class="text-body-secondary mb-0">
                Dernière modification le @Model.UpdatedAtUtc.ToString("dd/MM/yyyy à HH:mm") UTC
            </p>
        </div>

        @if (!Model.CanEdit)
        {
            <span class="badge text-bg-secondary">Lecture seule</span>
        }
    </header>

    @if (!Model.CanEdit)
    {
        <div class="alert alert-secondary" role="status">
            Vous pouvez consulter cette activité, mais votre rôle ne permet pas de la modifier.
        </div>
    }

    <form id="activity-edit-form"
          asp-controller="Activities"
          asp-action="Edit"
          method="post"
          data-can-edit="@Model.CanEdit.ToString().ToLowerInvariant()"
          data-original-activity-status="@Model.OriginalStatus">
        <input asp-for="TeamId" type="hidden" />
        <input asp-for="ActivityId" type="hidden" />
        <input asp-for="OriginalStatus" type="hidden" />
        <input asp-for="StatusChangeConfirmed"
               type="hidden"
               data-activity-status-confirmation />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="activity-edit-sheet">
            <section class="activity-edit-section activity-edit-state-section" aria-labelledby="activity-state-title">
                <h2 id="activity-state-title" class="activity-edit-section-title">État</h2>

                <div class="activity-edit-state-content">
                    <fieldset class="activity-edit-status-options">
                        <legend class="visually-hidden">État de l’activité</legend>

                        <label class="team-calendar-filter calendar-filter-planned activity-edit-status-option">
                            <input asp-for="Status"
                                   id="activity-status-planned"
                                   class="form-check-input activity-edit-status-choice"
                                   type="radio"
                                   value="@ActivityStatus.Planned"
                                   disabled="@(!Model.CanEdit)"
                                   data-activity-status-input />

                            <i class="bi bi-clock team-calendar-filter-icon" aria-hidden="true"></i>
                            <span>Planifiée</span>
                        </label>

                        <label class="team-calendar-filter calendar-filter-completed activity-edit-status-option">
                            <input asp-for="Status"
                                   id="activity-status-completed"
                                   class="form-check-input activity-edit-status-choice"
                                   type="radio"
                                   value="@ActivityStatus.Completed"
                                   disabled="@(!Model.CanEdit)"
                                   data-activity-status-input />

                            <i class="bi bi-check-lg team-calendar-filter-icon" aria-hidden="true"></i>
                            <span>Terminée</span>
                        </label>

                        <label class="team-calendar-filter calendar-filter-cancelled activity-edit-status-option">
                            <input asp-for="Status"
                                   id="activity-status-cancelled"
                                   class="form-check-input activity-edit-status-choice"
                                   type="radio"
                                   value="@ActivityStatus.Cancelled"
                                   disabled="@(!Model.CanEdit)"
                                   data-activity-status-input />

                            <i class="bi bi-x-lg team-calendar-filter-icon" aria-hidden="true"></i>
                            <span>Annulée</span>
                        </label>
                    </fieldset>

                    <div class="activity-edit-field activity-edit-cancellation-field">
                        <label asp-for="CancellationReason" class="activity-edit-field-label"></label>

                        <input asp-for="CancellationReason"
                               class="form-control activity-edit-control"
                               maxlength="500"
                               placeholder="Facultatif · actif uniquement si Annulée"
                               disabled="@(!Model.CanEdit || Model.Status != ActivityStatus.Cancelled)"
                               data-activity-cancellation-input />

                        <span asp-validation-for="CancellationReason" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-main-information-title">
                <h2 id="activity-main-information-title" class="activity-edit-section-title">Informations principales</h2>

                <div class="activity-edit-grid activity-edit-grid-two-columns">
                    <div class="activity-edit-field">
                        <label asp-for="ActivityTypeId" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <select asp-for="ActivityTypeId"
                                    class="form-select activity-edit-control"
                                    data-activity-type-select>
                                @foreach (var activityType in Model.ActivityTypes)
                                {
                                    <option value="@activityType.ActivityTypeId" data-type-code="@activityType.Code">
                                        @activityType.Label
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="ActivityTypeId" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">@Model.TypeLabel</div>
                        }
                    </div>

                    <div class="activity-edit-field">
                        <label asp-for="Subtitle" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="Subtitle"
                                   class="form-control activity-edit-control"
                                   maxlength="100"
                                   placeholder="Facultatif" />

                            <span asp-validation-for="Subtitle" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">@(Model.Subtitle ?? "Non renseigné")</div>
                        }
                    </div>
                </div>
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-schedule-title">
                <h2 id="activity-schedule-title" class="activity-edit-section-title">Horaires et fuseau</h2>

                <div class="activity-edit-grid activity-edit-grid-two-columns">
                    <div class="activity-edit-field">
                        <label asp-for="PlannedStartLocal" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="PlannedStartLocal"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control activity-edit-control"
                                   type="datetime-local" />

                            <span asp-validation-for="PlannedStartLocal" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">
                                @Model.PlannedStartLocal?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                    </div>

                    <div class="activity-edit-field">
                        <label asp-for="PlannedEndLocal" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="PlannedEndLocal"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control activity-edit-control"
                                   type="datetime-local" />

                            <span asp-validation-for="PlannedEndLocal" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">
                                @Model.PlannedEndLocal?.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                    </div>
                </div>

                <p class="activity-edit-time-zone mb-0">
                    Fuseau de l’équipe appliqué : <strong>@Model.TimeZoneId</strong>
                </p>
            </section>

            <section class="activity-edit-section"
                     aria-labelledby="activity-match-title"
                     data-activity-match-section
                     hidden="@(!matchSectionIsVisible)">
                <h2 id="activity-match-title" class="activity-edit-section-title">Match</h2>

                <div class="activity-edit-grid activity-edit-grid-four-columns">
                    <div class="activity-edit-field">
                        <label asp-for="OpponentName" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="OpponentName"
                                   class="form-control activity-edit-control"
                                   maxlength="100"
                                   placeholder="Obligatoire"
                                   required="@matchSectionIsVisible"
                                   disabled="@(!matchSectionIsVisible)"
                                   data-activity-match-input
                                   data-activity-opponent-input
                                   data-msg-required="L’équipe adverse est obligatoire pour une pracc ou un match officiel." />

                            <span asp-validation-for="OpponentName" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">@(Model.OpponentName ?? "Non renseignée")</div>
                        }
                    </div>

                    <div class="activity-edit-field">
                        <label asp-for="TeamScore" class="activity-edit-field-label">Score de @Model.TeamName</label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="TeamScore"
                                   class="form-control activity-edit-control"
                                   type="number"
                                   min="0"
                                   step="1"
                                   required="@(matchSectionIsVisible && Model.Status == ActivityStatus.Completed)"
                                   disabled="@(!matchSectionIsVisible)"
                                   data-activity-match-input
                                   data-activity-score-input
                                   data-msg-required="Les deux scores sont obligatoires." />

                            <span asp-validation-for="TeamScore" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">@(Model.TeamScore?.ToString() ?? "—")</div>
                        }
                    </div>

                    <div class="activity-edit-field">
                        <label asp-for="OpponentScore" class="activity-edit-field-label"></label>

                        @if (Model.CanEdit)
                        {
                            <input asp-for="OpponentScore"
                                   class="form-control activity-edit-control"
                                   type="number"
                                   min="0"
                                   step="1"
                                   required="@(matchSectionIsVisible && Model.Status == ActivityStatus.Completed)"
                                   disabled="@(!matchSectionIsVisible)"
                                   data-activity-match-input
                                   data-activity-score-input
                                   data-msg-required="Les deux scores sont obligatoires." />

                            <span asp-validation-for="OpponentScore" class="text-danger"></span>
                        }
                        else
                        {
                            <div class="activity-edit-readonly-value">@(Model.OpponentScore?.ToString() ?? "—")</div>
                        }
                    </div>

                    <div class="activity-edit-readonly-field">
                        <span class="activity-edit-field-label">Résultat calculé</span>
                        <span data-activity-result-label>@resultLabel</span>
                    </div>
                </div>
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-participants-title">
                @{
                    bool allParticipantsAreSelected = Model.Participants.Count > 0 && Model.Participants.All(participant => participant.IsSelected);
                    bool selectedParticipantExists = Model.Participants.Any(participant => participant.IsSelected);
                    bool allSelectedParticipantsArePresent = selectedParticipantExists && Model.Participants.Where(participant => participant.IsSelected).All(participant => participant.IsPresent);
                }

                <h2 id="activity-participants-title"
                    class="activity-edit-section-title mb-0">
                    Participants et présences
                </h2>

                @if (Model.Participants.Count == 0)
                {
                    <p class="text-body-secondary mt-3 mb-0">Aucun participant associé.</p>
                }
                else
                {
                    <div class="activity-edit-participant-list mt-3">
                        <div class="activity-edit-participant-column-headers">
                            <span>Participants</span>

                            <div class="activity-edit-participant-column-heading">
                                <span>Inclus</span>

                                @if (Model.CanEdit)
                                {
                                    <div class="form-check activity-edit-participant-header-control">
                                        <input id="activity-edit-participant-select-all"
                                               class="form-check-input"
                                               type="checkbox"
                                               checked="@allParticipantsAreSelected"
                                               data-activity-participant-select-all />

                                        <label class="visually-hidden"
                                               for="activity-edit-participant-select-all">
                                            Inclure tous les participants
                                        </label>
                                    </div>
                                }
                            </div>

                            <div class="activity-edit-participant-column-heading">
                                <span>Présent</span>

                                @if (Model.CanEdit)
                                {
                                    <div class="form-check activity-edit-participant-header-control"
                                         data-activity-attendance-control
                                         hidden="@(Model.Status != ActivityStatus.Completed)">
                                        <input id="activity-edit-attendance-select-all"
                                               class="form-check-input"
                                               type="checkbox"
                                               checked="@allSelectedParticipantsArePresent"
                                               disabled="@(Model.Status != ActivityStatus.Completed)"
                                               data-activity-attendance-select-all />

                                        <label class="visually-hidden"
                                               for="activity-edit-attendance-select-all">
                                            Marquer tous les participants inclus comme présents
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        @for (int index = 0; index < Model.Participants.Count; index++)
                        {
                            <div class="activity-edit-participant" data-activity-participant-row>
                                @if (Model.CanEdit)
                                {
                                    <input asp-for="Participants[index].TeamMembershipId" type="hidden" />
                                }

                                <div class="activity-edit-participant-identity">
                                    <span class="activity-edit-participant-name">@Model.Participants[index].DisplayName</span>
                                    <span class="badge text-bg-secondary">@Model.Participants[index].RoleLabel</span>

                                    @if (Model.Participants[index].IsOwner)
                                    {
                                        <span class="badge team-owner-badge">Propriétaire</span>
                                    }

                                    @if (Model.Participants[index].IsFormerMember)
                                    {
                                        <span class="badge text-bg-secondary">Ancien membre</span>
                                    }
                                </div>

                                @if (Model.CanEdit)
                                {
                                    <div class="form-check activity-edit-participant-control">
                                        <input asp-for="Participants[index].IsSelected"
                                               class="form-check-input"
                                               data-activity-participant-checkbox />

                                        <label asp-for="Participants[index].IsSelected" class="visually-hidden">
                                            Inclure @Model.Participants[index].DisplayName
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <span class="activity-edit-participant-value">
                                        @(Model.Participants[index].IsSelected ? "Oui" : "Non")
                                    </span>
                                }

                                @if (Model.CanEdit)
                                {
                                    <div class="form-check activity-edit-participant-control"
                                         data-activity-attendance-control
                                         hidden="@(Model.Status != ActivityStatus.Completed)">
                                        <input asp-for="Participants[index].IsPresent"
                                               class="form-check-input"
                                               disabled="@(Model.Status != ActivityStatus.Completed || !Model.Participants[index].IsSelected)"
                                               data-activity-attendance-checkbox />

                                        <label asp-for="Participants[index].IsPresent" class="visually-hidden">
                                            Marquer @Model.Participants[index].DisplayName présent
                                        </label>
                                    </div>
                                }
                                else if (Model.OriginalStatus == ActivityStatus.Completed && Model.Participants[index].IsSelected)
                                {
                                    <span class="activity-edit-participant-value">
                                        @(Model.Participants[index].IsPresent ? "Présent" : "Absent")
                                    </span>
                                }
                                else
                                {
                                    <span class="activity-edit-participant-value">—</span>
                                }
                            </div>
                        }
                    </div>
                }

                <span asp-validation-for="Participants" class="text-danger"></span>
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-description-title">
                <h2 id="activity-description-title" class="activity-edit-section-title">Description</h2>

                @if (Model.CanEdit)
                {
                    <textarea asp-for="Description"
                              class="form-control activity-edit-control activity-edit-textarea"
                              rows="5"
                              maxlength="2000"
                              placeholder="Facultatif"></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                }
                else
                {
                    <div class="activity-edit-multiline-value">
                        @(Model.Description ?? "Aucune description")
                    </div>
                }
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-links-title">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <h2 id="activity-links-title" class="activity-edit-section-title mb-0">Liens</h2>

                    @if (Model.CanEdit)
                    {
                        <button id="activity-edit-add-link"
                                class="btn btn-outline-secondary btn-sm"
                                type="button"
                                data-add-activity-link>
                            <span aria-hidden="true">+</span>
                            Ajouter un lien
                        </button>
                    }
                </div>

                @if (Model.CanEdit)
                {
                    <p class="d-flex flex-wrap align-items-center gap-2 text-body-secondary mt-3 mb-3">
                        <span class="badge text-bg-success">HTTPS recommandé</span>
                        <span>Les liens HTTP restent acceptés.</span>
                    </p>

                    <div id="activity-edit-link-list"
                         class="activity-link-list"
                         aria-label="Liens de l’activité"
                         aria-live="polite"
                         data-activity-link-list>

                        <div class="row g-3 activity-edit-link-column-headers" aria-hidden="true">
                            <span class="col-5 col-md-4">Nom du lien</span>
                            <span class="col-7 col-md">URL</span>
                            <span class="d-none d-md-block col-md-auto activity-link-remove-column"></span>
                        </div>

                        @for (int index = 0; index < Model.Links.Count; index++)
                        {
                            <div class="activity-link-item" data-activity-link-row data-link-index="@index">
                                <input type="hidden" name="Links.Index" value="@index" />
                                <input asp-for="Links[index].ActivityLinkId" type="hidden" />

                                <div class="row g-3 align-items-start">
                                    <div class="col-5 col-md-4">
                                        <label asp-for="Links[index].Name" class="visually-hidden"></label>
                                        <input asp-for="Links[index].Name"
                                               class="form-control activity-edit-control"
                                               maxlength="100" />
                                        <span asp-validation-for="Links[index].Name" class="text-danger"></span>
                                    </div>

                                    <div class="col-7 col-md">
                                        <label asp-for="Links[index].Url" class="visually-hidden"></label>
                                        <input asp-for="Links[index].Url"
                                               class="form-control activity-edit-control"
                                               type="url"
                                               maxlength="2048" />
                                        <span asp-validation-for="Links[index].Url" class="text-danger"></span>
                                    </div>

                                    <div class="col-12 col-md-auto activity-link-remove-column">
                                        <button class="btn btn-outline-danger btn-sm"
                                                type="button"
                                                data-remove-activity-link
                                                aria-label="Supprimer ce lien">
                                            Supprimer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <template id="activity-edit-link-template">
                        <div class="activity-link-item" data-activity-link-row>
                            <input type="hidden" name="Links.Index" data-link-index-field />
                            <input type="hidden" value="@Guid.Empty" data-link-id-input />

                            <div class="row g-3 align-items-start">
                                <div class="col-5 col-md-4">
                                    <label class="visually-hidden" data-link-name-label>Nom du lien</label>
                                    <input class="form-control activity-edit-control"
                                           type="text"
                                           maxlength="100"
                                           data-link-name-input
                                           data-val="true"
                                           data-val-required="Le nom du lien est obligatoire."
                                           data-val-length="Le nom du lien ne peut pas dépasser 100 caractères."
                                           data-val-length-max="100" />
                                    <span class="text-danger field-validation-valid"
                                          data-link-name-validation
                                          data-valmsg-replace="true"></span>
                                </div>

                                <div class="col-7 col-md">
                                    <label class="visually-hidden" data-link-url-label>URL</label>
                                    <input class="form-control activity-edit-control"
                                           type="url"
                                           maxlength="2048"
                                           data-link-url-input
                                           data-val="true"
                                           data-val-required="L’URL du lien est obligatoire."
                                           data-val-length="L’URL du lien ne peut pas dépasser 2 048 caractères."
                                           data-val-length-max="2048"
                                           data-val-regex="L’URL doit utiliser le protocole HTTP ou HTTPS."
                                           data-val-regex-pattern="^[Hh][Tt][Tt][Pp][Ss]?://.+$" />
                                    <span class="text-danger field-validation-valid"
                                          data-link-url-validation
                                          data-valmsg-replace="true"></span>
                                </div>

                                <div class="col-12 col-md-auto activity-link-remove-column">
                                    <button class="btn btn-outline-danger btn-sm"
                                            type="button"
                                            data-remove-activity-link
                                            aria-label="Supprimer ce lien">
                                        Supprimer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>
                }
                else if (Model.Links.Count == 0)
                {
                    <p class="text-body-secondary mt-3 mb-0">Aucun lien associé.</p>
                }
                else
                {
                    <div class="activity-edit-link-list mt-3">
                        @foreach (var link in Model.Links)
                        {
                            bool linkUsesHttps = link.Url?.StartsWith("https://", StringComparison.OrdinalIgnoreCase) == true;

                            <div class="activity-edit-link">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span>@link.Name</span>
                                    <span class="badge @(linkUsesHttps ? "text-bg-success" : "text-bg-secondary")">
                                        @(linkUsesHttps ? "HTTPS" : "HTTP")
                                    </span>
                                </div>

                                <a href="@link.Url" target="_blank" rel="noopener noreferrer">
                                    @link.Url
                                </a>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-strategies-title">
                <h2 id="activity-strategies-title" class="activity-edit-section-title">Stratégies associées</h2>

                <p class="text-body-secondary mb-0">
                    Aucune stratégie associée.
                </p>
            </section>

            <section class="activity-edit-section" aria-labelledby="activity-report-title">
                <h2 id="activity-report-title" class="activity-edit-section-title">Compte rendu</h2>

                @if (Model.CanEdit)
                {
                    <textarea asp-for="Report"
                              class="form-control activity-edit-control activity-edit-textarea"
                              rows="7"
                              maxlength="5000"
                              placeholder="Facultatif"></textarea>

                    <span asp-validation-for="Report" class="text-danger"></span>
                }
                else
                {
                    <div class="activity-edit-multiline-value">
                        @(Model.Report ?? "Aucun compte rendu")
                    </div>
                }
            </section>
        </div>

        <div class="activity-edit-actions">
            <a class="btn btn-outline-secondary"
               asp-controller="Activities"
               asp-action="Index"
               asp-route-teamId="@Model.TeamId">
                Retour au calendrier
            </a>

            @if (Model.CanEdit)
            {
                <button class="btn btn-primary" type="submit">
                    Enregistrer les modifications
                </button>
            }
        </div>
    </form>
</section>

@section Styles
{
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/activities-edit.js" asp-append-version="true"></script>
}