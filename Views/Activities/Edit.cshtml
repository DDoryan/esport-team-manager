@model RepriseWeb.Models.TeamActivity

@{
    ViewData["Title"] = "Modifier une activité";
}

<h1>Modifier une activité</h1>

<form asp-controller="Activities"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            Titre
        </label>

        <input asp-for="Title" class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label">
            Type
        </label>

        <select asp-for="Type" class="form-select">
            <option value="">Choisir un type</option>
            <option value="Entraînement">Entraînement</option>
            <option value="Review">Review</option>
            <option value="Réunion">Réunion</option>
        </select>

        <span asp-validation-for="Type"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">
            Date et heure
        </label>

        <input asp-for="StartDate"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               type="datetime-local"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Enregistrer les modifications
    </button>

    <a asp-controller="Activities"
       asp-action="Index"
       class="btn btn-secondary">
        Annuler
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
