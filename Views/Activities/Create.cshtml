@model RepriseWeb.Models.TeamActivity

@{
    ViewData["Title"] = "Créer une activité";
}

<h1>Créer une activité</h1>

<form asp-controller="Activities"
      asp-action="Create"
      method="post">

    <div class="mb-3">
        <label asp-for="Title" class="form-label">
            Titre
        </label>

        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Type" class="form-label">
            Type
        </label>

        <select asp-for="Type" class="form-select">
            <option value="">Choisir un type</option>
            <option value="Entraînement">Entraînement</option>
            <option value="Review">Review</option>
            <option value="Réunion">Réunion</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">
            Date et heure
        </label>

        <input asp-for="StartDate"
               type="datetime-local"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Enregistrer
    </button>

    <a asp-controller="Activities"
       asp-action="Index"
       class="btn btn-secondary">
        Annuler
    </a>
</form>
