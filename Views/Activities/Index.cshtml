@model IReadOnlyCollection<RepriseWeb.ViewModels.Activities.ActivityListItemViewModel>

@{
    ViewData["Title"] = "Activités";
}

<h1>Activités de l’équipe</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary" role="status">
        Aucune activité planifiée ou terminée.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark table-striped align-middle">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Sous-titre</th>
                    <th>Début prévu</th>
                    <th>Fin prévue</th>
                    <th>Fuseau</th>
                    <th>État</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var activity in Model)
                {
                    <tr>
                        <td>@activity.TypeLabel</td>
                        <td>@(activity.Subtitle ?? "—")</td>
                        <td>@activity.PlannedStartUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@activity.PlannedEndUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@activity.TimeZoneId</td>
                        <td>@activity.StatusLabel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}