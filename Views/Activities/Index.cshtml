@model RepriseWeb.ViewModels.Activities.TeamCalendarViewModel

@{
    ViewData["Title"] = $"Calendrier — {Model.TeamName}";
    string eventsUrl = Url.Action("Events", "Activities", new { teamId = Model.TeamId }) ?? string.Empty;
}

<section class="team-calendar-page" aria-labelledby="calendar-title">
    <header class="team-calendar-header mb-4">
        <div>
            <h1 id="calendar-title" class="mb-2">Calendrier — @Model.TeamName</h1>
            <p class="text-body-secondary mb-0">
                Fuseau horaire de l’équipe : <strong>@Model.TimeZoneId</strong>
            </p>
        </div>

        @if (Model.CanCreateActivity)
        {
            <a class="btn btn-primary team-calendar-create-button"
               asp-controller="Activities"
               asp-action="Create"
               asp-route-teamId="@Model.TeamId">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>
                Créer une activité
            </a>
        }
    </header>

    <div class="team-calendar-desktop">
        <p id="calendar-scroll-help" class="visually-hidden">
            Le calendrier peut défiler horizontalement lorsque son contenu dépasse la largeur disponible.
        </p>

        <div class="team-calendar-frame" tabindex="0" aria-describedby="calendar-scroll-help">
            <div id="team-calendar"
                 data-events-url="@eventsUrl"
                 data-team-time-zone="@Model.TimeZoneId"
                 aria-label="Calendrier de l’équipe @Model.TeamName">
            </div>
        </div>

        <input id="calendar-date-picker"
               class="calendar-date-picker"
               type="date"
               tabindex="-1"
               aria-label="Sélectionner une date du calendrier" />
    </div>

    <section id="team-activity-list"
             class="team-activity-list"
             aria-labelledby="team-activity-list-title"
             aria-busy="true">
        <h2 id="team-activity-list-title" class="visually-hidden">
            Activités des quatre semaines affichées
        </h2>

        <p class="team-activity-list-loading text-body-secondary mb-0" role="status">
            Chargement des activités…
        </p>

        <ol class="team-activity-list-items list-unstyled mb-0"></ol>

        <p class="team-activity-list-empty text-body-secondary mb-0" role="status" hidden>
            Aucune activité planifiée ou terminée pendant ces quatre semaines.
        </p>
    </section>

    <div id="calendar-load-error" class="alert alert-danger mt-3" role="alert" hidden>
        Le calendrier n’a pas pu être chargé. Veuillez actualiser la page.
    </div>

    <noscript>
        <div class="alert alert-warning mt-3" role="alert">
            JavaScript doit être activé pour afficher le calendrier.
        </div>
    </noscript>
</section>

@section Styles
{
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/fullcalendar/skeleton.css" />
    <link rel="stylesheet" href="~/lib/fullcalendar-bootstrap5/theme.css" />
}

@section Scripts
{
    <script src="~/lib/fullcalendar/all/global.min.js"></script>
    <script src="~/lib/fullcalendar/locales/fr/global.min.js"></script>
    <script src="~/lib/fullcalendar-bootstrap5/global.min.js"></script>
    <script src="~/js/activities-calendar.js" asp-append-version="true"></script>
}