@model IEnumerable<RepriseWeb.Models.TeamActivity>

@{
    ViewData["Title"] = "Activités";
}

<h1>Activités de l’équipe</h1>

<a class="btn btn-success mb-3"
   asp-controller="Activities"
   asp-action="Create">
    Créer une activité
</a>

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Type</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var activity in Model)
        {
            <tr>
                <td>@activity.Title</td>
                <td>@activity.Type</td>
                <td>@activity.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a class="btn btn-outline-primary btn-sm"
                       asp-controller="Activities"
                       asp-action="Details"
                       asp-route-id="@activity.Id">
                        Détails
                    </a>

                    <a class="btn btn-outline-warning btn-sm"
                       asp-controller="Activities"
                       asp-action="Edit"
                       asp-route-id="@activity.Id">
                        Modifier
                    </a>

                    <a class="btn btn-outline-danger btn-sm"
                       asp-controller="Activities"
                       asp-action="Delete"
                       asp-route-id="@activity.Id">
                        Supprimer
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>