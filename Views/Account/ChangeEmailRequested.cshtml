@{
    ViewData["Title"] = "Demande prise en compte";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Demande prise en compte</h1>

                    <p class="text-body-secondary">
                        Un courriel de confirmation a été envoyé à votre nouvelle adresse e-mail.
                    </p>

                    <p class="text-body-secondary">
                        Le lien est valable pendant une heure. Votre adresse actuelle reste active tant que la nouvelle adresse n’a pas été confirmée.
                    </p>

                    <a asp-controller="Account" asp-action="Profile">← Retour au profil</a>
                </div>
            </div>
        </div>
    </div>
</section>