@{
    ViewData["Title"] = "Mot de passe modifié";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Mot de passe modifié</h1>

                    <p class="text-body-secondary">
                        Votre mot de passe a été réinitialisé. Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.
                    </p>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Se connecter
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>