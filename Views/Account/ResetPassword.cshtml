@model EsportTeamManager.Web.Models.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Nouveau mot de passe</h1>

                    <p class="text-body-secondary">
                        Le lien est valable pendant une heure et ne fonctionne qu’une seule fois.
                    </p>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post">
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>

                            <div class="input-group">
                                <input asp-for="Password" class="form-control password-field" autocomplete="new-password" />

                                <button type="button" class="btn btn-outline-secondary password-toggle" data-password-target="Password" aria-controls="Password" aria-label="Afficher le mot de passe" aria-pressed="false">
                                    <svg class="eye-open d-none" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <circle cx="8" cy="8" r="2" />
                                    </svg>

                                    <svg class="eye-closed" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="M2 2l12 12" />
                                    </svg>
                                </button>
                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>

                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control password-field" autocomplete="new-password" />

                                <button type="button" class="btn btn-outline-secondary password-toggle" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Afficher la confirmation du mot de passe" aria-pressed="false">
                                    <svg class="eye-open d-none" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <circle cx="8" cy="8" r="2" />
                                    </svg>

                                    <svg class="eye-closed" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="M2 2l12 12" />
                                    </svg>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-text mb-3">
                            Le mot de passe doit contenir au moins 8 caractères, une minuscule, une majuscule, un chiffre et un caractère non alphanumérique.
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Enregistrer</button>

                        <p class="text-center mt-3 mb-0">
                            <a asp-controller="Account" asp-action="Login">← Retour</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordToggleButtons = document.querySelectorAll(".password-toggle");

        passwordToggleButtons.forEach(button => {
            button.addEventListener("click", () => {
                const passwordField = document.getElementById(button.dataset.passwordTarget);
                const passwordIsVisible = passwordField.type === "text";
                const newVisibility = !passwordIsVisible;

                passwordField.type = newVisibility ? "text" : "password";

                button.querySelector(".eye-open").classList.toggle("d-none", !newVisibility);
                button.querySelector(".eye-closed").classList.toggle("d-none", newVisibility);
                button.setAttribute("aria-label", newVisibility ? "Masquer le mot de passe" : "Afficher le mot de passe");
                button.setAttribute("aria-pressed", newVisibility.toString());
            });
        });
    </script>
}