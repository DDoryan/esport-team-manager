@model EsportTeamManager.Web.Models.Account.ResendConfirmationViewModel

@{
    ViewData["Title"] = "Renvoyer le courriel de confirmation";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Renvoyer le courriel de confirmation</h1>

                    <p class="text-body-secondary">
                        Saisissez l’adresse électronique utilisée lors de votre inscription.
                    </p>

                    <form asp-controller="Account" asp-action="ResendConfirmation" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Demander un nouveau courriel</button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-controller="Home" asp-action="Index">Retour à l’accueil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}