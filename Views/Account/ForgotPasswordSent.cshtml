@{
    ViewData["Title"] = "Demande prise en compte";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Demande prise en compte</h1>

                    <p class="text-body-secondary">
                        Si un compte confirmé correspond à l’adresse indiquée et que la limite d’envoi n’est pas atteinte, un lien de réinitialisation sera envoyé.
                    </p>

                    <p class="mb-0">
                        <a asp-controller="Account" asp-action="Login">← Retour à la connexion</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>