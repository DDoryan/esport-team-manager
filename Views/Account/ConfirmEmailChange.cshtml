@model EsportTeamManager.Web.Models.Account.ConfirmEmailChangeViewModel

@{
    ViewData["Title"] = Model.Succeeded ? "Adresse e-mail modifiée" : "Confirmation impossible";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">
                        @(Model.Succeeded ? "Adresse e-mail modifiée" : "Confirmation impossible")
                    </h1>

                    <div class="alert @(Model.Succeeded ? "alert-success" : "alert-danger")" role="@(Model.Succeeded ? "status" : "alert")">
                        @Model.Message
                    </div>

                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Se connecter
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>