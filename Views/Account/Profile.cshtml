@model EsportTeamManager.Web.Models.Account.ProfileViewModel

@{
    ViewData["Title"] = "Mon profil";
}

<section class="container py-4">
    <h1 id="profile-title" class="mb-2">Mon profil</h1>

    <p class="text-body-secondary mb-0">
        L’identité Pseudo #tag ne peut jamais être modifiée.
    </p>

    @if (TempData["ProfileSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success mt-3" role="status">
            @successMessage
        </div>
    }

    <div class="row g-4 mt-3">
        <div class="col-12 col-lg-6">
            <div class="card border-secondary shadow-sm profile-information-card w-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between profile-information-spacing">
                    <h2 class="h2 mb-0">Informations du compte</h2>

                    <div class="d-flex flex-column profile-account-details">
                        <div>
                            <div class="text-body-secondary mb-2">Pseudo #tag</div>

                            <div class="d-flex justify-content-between align-items-center gap-3">
                                <span class="fs-5 fw-bold">@Model.DisplayIdentity</span>

                                <span class="badge rounded-pill bg-secondary text-light px-3 py-2">
                                    Immuable
                                </span>
                            </div>
                        </div>

                        <div>
                            <div class="text-body-secondary mb-2">Adresse e-mail</div>
                            <div class="fs-5 fw-bold">@Model.Email</div>

                            <div class="mt-3">
                                <a asp-controller="Account" asp-action="ChangeEmail" class="btn btn-primary">
                                    Modifier mon adresse e-mail
                                </a>
                            </div>
                        </div>
                        
                        <div>
                            <div class="text-body-secondary mb-2">Mot de passe</div>
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-primary">
                                Modifier mon mot de passe
                            </a>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>