@{
    ViewData["Title"] = "Réinitialisation impossible";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Réinitialisation impossible</h1>

                    <p class="text-body-secondary">
                        Le lien de réinitialisation est invalide, incomplet, expiré ou a déjà été utilisé.
                    </p>

                    <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-primary w-100">
                        Demander un nouveau lien
                    </a>

                    <p class="text-center mt-3 mb-0">
                        <a asp-controller="Account" asp-action="Login">← Retour</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>