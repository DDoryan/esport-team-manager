@{
    ViewData["Title"] = "Compte créé";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4 text-center">
                    <h1 class="h2 mb-3">Compte créé</h1>

                    <div class="alert alert-success" role="status">
                        Votre compte a bien été créé.
                    </div>

                    <p>
                        Votre adresse électronique doit maintenant être confirmée avant que vous puissiez vous connecter.
                    </p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a asp-controller="Account" asp-action="ResendConfirmation" class="btn btn-primary">Renvoyer le courriel</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Retour à l’accueil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>