@model EsportTeamManager.Web.Models.Account.RegisterViewModel

@{
    ViewData["Title"] = "Créer un compte";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Créer un compte</h1>

                    <p class="text-body-secondary">
                        Créez votre identité permanente pour rejoindre ou gérer une équipe.
                    </p>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Pseudo" class="form-label"></label>
                            <input asp-for="Pseudo" class="form-control" autocomplete="nickname" />
                            <div class="form-text">Le pseudonyme contiendra entre 3 et 20 caractères et ne pourra plus être modifié.</div>
                            <span asp-validation-for="Pseudo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tag" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">#</span>
                                <input asp-for="Tag" class="form-control" autocomplete="off" />
                            </div>
                            <div class="form-text">Le tag doit contenir entre 3 et 5 lettres ou chiffres.</div>
                            <span asp-validation-for="Tag" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>

                            <div class="input-group">
                                <input asp-for="Password" class="form-control password-field" autocomplete="new-password" />

                                <button type="button" class="btn btn-outline-secondary password-toggle" data-password-target="Password" aria-controls="Password" aria-label="Afficher le mot de passe" aria-pressed="false">
                                    <svg class="eye-open d-none" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <circle cx="8" cy="8" r="2" />
                                    </svg>

                                    <svg class="eye-closed" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="M2 2l12 12" />
                                    </svg>
                                </button>
                            </div>

                            <div class="form-text">
                                Au moins 8 caractères avec une minuscule, une majuscule, un chiffre et un caractère non alphanumérique.
                            </div>

                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>

                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control password-field" autocomplete="new-password" />

                                <button type="button" class="btn btn-outline-secondary password-toggle" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Afficher la confirmation du mot de passe" aria-pressed="false">
                                    <svg class="eye-open d-none" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <circle cx="8" cy="8" r="2" />
                                    </svg>

                                    <svg class="eye-closed" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true">
                                        <path d="M1.5 8s2.5-4 6.5-4 6.5 4 6.5 4-2.5 4-6.5 4S1.5 8 1.5 8Z" />
                                        <path d="M2 2l12 12" />
                                    </svg>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="MinimumAgeConfirmed" class="form-check-input" />
                            <label asp-for="MinimumAgeConfirmed" class="form-check-label"></label>
                            <span asp-validation-for="MinimumAgeConfirmed" class="text-danger d-block"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="TermsAccepted" class="form-check-input" />
                            <label asp-for="TermsAccepted" class="form-check-label"></label>
                            <span asp-validation-for="TermsAccepted" class="text-danger d-block"></span>
                        </div>

                        <p class="small text-body-secondary">
                            Aucune date de naissance n’est enregistrée. Seule la déclaration du respect de l’âge minimum est horodatée.
                        </p>

                        <button type="submit" class="btn btn-primary w-100">Créer mon compte</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordToggleButtons = document.querySelectorAll(".password-toggle");

        passwordToggleButtons.forEach(button => {
            button.addEventListener("click", () => {
                const passwordField = document.getElementById(button.dataset.passwordTarget);
                const passwordIsVisible = passwordField.type === "text";
                const newVisibility = !passwordIsVisible;

                passwordField.type = newVisibility ? "text" : "password";

                button.querySelector(".eye-open").classList.toggle("d-none", !newVisibility);
                button.querySelector(".eye-closed").classList.toggle("d-none", newVisibility);
                button.setAttribute("aria-label", newVisibility ? "Masquer le mot de passe" : "Afficher le mot de passe");
                button.setAttribute("aria-pressed", newVisibility.toString());
            });
        });
    </script>
}