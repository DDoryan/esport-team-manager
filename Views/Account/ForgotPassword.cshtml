@model EsportTeamManager.Web.Models.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Mot de passe oublié";
}

<section class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-secondary shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h2 mb-3">Mot de passe oublié</h1>

                    <p class="text-body-secondary">
                        Saisissez votre adresse électronique. Le message affiché restera identique, que cette adresse corresponde ou non à un compte.
                    </p>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-2">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <p class="small text-body-secondary mb-3">
                            Trois demandes maximum sont autorisées par heure.
                        </p>

                        <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>

                        <p class="text-center mt-3 mb-0">
                            <a asp-controller="Account" asp-action="Login">← Retour</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}